#!/usr/bin/env python3
"""fake-set <repo> <field> <value>"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fake_lib as L

repo, field, value = sys.argv[1:4]
path = L.repo_path(repo)
if not path.exists() or field != "status" or value not in L.STATUSES:
    print("fake-set: refused", file=sys.stderr)
    sys.exit(1)
L.set_status(path, value)
print(f"{repo}: {field} -> {value}")
