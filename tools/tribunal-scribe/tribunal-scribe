#!/usr/bin/env python3
"""tribunal-scribe — physical sealing + verbatim record for a tribunal workspace (judges must
not write or commit the record; every turn is framed and hash-checked).

Replaces judge/orchestrator-written seat-*.md/turns/*.md/transcript.md with a single script
that is the ONLY writer of the record. Subcommands:

  open <ws>                        create <ws>/.tribunal-active (head=<git HEAD sha>,
                                    opened=<ISO time>) + <ws>/turns/. Refuses (exit 1) prior-run
                                    leftovers (turns/, seat-*.md, transcript.md already present).
  append <ws> <round> <seat> <lens> <payload-file>
                                    copy payload bytes verbatim into <ws>/turns/r<round>-s<seat>.md
                                    (round 0 also into <ws>/seat-<seat>-<lens>.md), append a framed
                                    turn to <ws>/transcript.md under its `## Round <k>` heading, and
                                    record the new transcript sha in <ws>/TRANSCRIPT.SHA256. Seats
                                    are labelled by lens only, never a model name.
  close <ws> <reason> <round>      append `## Closed — <reason>, round <k>`, update
                                    TRANSCRIPT.SHA256, remove the marker. reason must be one of
                                    saturation|cap|refuter-handoff.
  verify <ws> [--expect-head <sha>] recompute every turns/ file's sha against its transcript
                                    heading, the transcript sha against TRANSCRIPT.SHA256's last
                                    line, and every fenced payload in transcript.md against its
                                    turns/ file, byte for byte, and verify CHAIN.SHA256.
                                    Exit 0 clean, 3 with a list, 2 for invalid arguments.

Every append/close adds a CHAIN.SHA256 record and prints `chain-head <sha>` (close also
prints `close-head: <sha>`). Retain that head outside the workspace and supply it to
`verify --expect-head` to detect a consistent rewrite or rollback. Plain verify checks
local consistency only: an editable workspace cannot authenticate its own head. No
external anchor storage, host policy, or automatic commits are provided by this tool.

Integrity check (append/close), both required:
  1. If <ws>/TRANSCRIPT.SHA256 exists, its last line's sha must equal sha256(transcript.md) —
     else exit 3 "transcript modified outside scribe" (catches hand-editing).
  2. `git log <marker head>..HEAD -- <ws>/turns <ws>/seat-*.md <ws>/transcript.md` must be
     empty — else exit 3 naming the offending commits (catches a non-scribe commit; this is
     the reason an auto-commit tool should skip directories that hold a `.tribunal-active` marker).

Fence framing: each turn is embedded between a pair of backtick fences whose length is
max(3, longest run of consecutive backticks inside the payload + 1) — guarantees no line
inside the payload can be mistaken for the closing fence, so a payload that itself contains
```` ``` ```` or a spoofed `### Seat n` / `## Closed` line stays inert data inside the envelope.
Because a fence's closing line must sit on its own line, a payload with no trailing newline
gets exactly one appended before the closing fence when embedded in transcript.md; `verify`
accounts for that one controlled byte when comparing the fenced region back to the turns/ file
(see FENCE_TRAILING_NEWLINE_NOTE below) — any other difference still fails verify.
"""
import hashlib
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

PROG = "tribunal-scribe"
REASONS = {"saturation", "cap", "refuter-handoff"}
CHAIN_NAME = "CHAIN.SHA256"

ROUND_RE = re.compile(b'^## Round (\\d+)(?: \xe2\x80\x94 opening statements)?$')
SEAT_RE = re.compile(rb'^### Seat (\d+) \((.*)\) sha256:([0-9a-f]{64})$')
FENCE_OPEN_RE = re.compile(rb'^(`{3,})turn$')

# \Z (not $) deliberately: Python's `$` matches just before a single trailing newline too, which
# would let a lens like "foo\n" slip past a naive `...foo$` pattern (argv can carry embedded
# newlines even though a shell command line rarely would). lens is used to build a filename
# (seat-<seat>-<lens>.md) so this also blocks path traversal (`../x`, `/etc/passsomething`).
LENS_RE = re.compile(r'^[a-z0-9][a-z0-9-]{0,40}\Z')


def die(code, msg):
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def marker_path(ws: Path) -> Path:
    return ws / ".tribunal-active"


def read_marker(ws: Path):
    p = marker_path(ws)
    if not p.exists():
        return None
    fields = {}
    for line in p.read_text().splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            fields[k.strip()] = v.strip()
    return fields


def require_marker(ws: Path):
    m = read_marker(ws)
    if not m or "head" not in m:
        die(1, f"no active tribunal marker in {ws} (run 'open' first)")
    return m


def transcript_sha_file(ws: Path) -> Path:
    return ws / "TRANSCRIPT.SHA256"


def last_recorded_sha(ws: Path):
    p = transcript_sha_file(ws)
    if not p.exists():
        return None
    lines = [l for l in p.read_text().splitlines() if l.strip()]
    if not lines:
        return None
    return lines[-1].split()[0]


def integrity_check(ws: Path, marker_head: str):
    """Shared by append/close. Exits 3 on any failure — see module docstring."""
    expected = last_recorded_sha(ws)
    if expected is not None:
        transcript = ws / "transcript.md"
        actual = sha256_file(transcript) if transcript.exists() else None
        if actual != expected:
            die(3, "transcript modified outside scribe "
                    f"(TRANSCRIPT.SHA256 last sha {expected}, actual {actual})")

    if not re.fullmatch(r"[0-9a-f]{40}", marker_head or ""):
        die(3, "marker head is not a 40-hex commit sha")
    turns_path = str(ws / "turns")
    seat_glob = str(ws) + "/seat-*.md"
    transcript_path = str(ws / "transcript.md")
    r = subprocess.run(
        ["git", "-C", str(ws), "log", "--format=%H", "--end-of-options", f"{marker_head}..HEAD",
         "--", turns_path, seat_glob, transcript_path],
        capture_output=True, text=True)
    if r.returncode != 0:
        die(3, f"git log failed while checking the record: {r.stderr.strip()}")
    commits = [c for c in r.stdout.split() if c]
    if commits:
        die(3, "non-scribe commit touched the record: " + ", ".join(commits))

    transcript = ws / "transcript.md"
    if transcript.exists() or (ws / CHAIN_NAME).exists():
        data = transcript.read_bytes() if transcript.is_file() else b""
        issues, _ = chain_issues(ws, data, _parse_transcript(data))
        if issues:
            die(3, "; ".join(issues))


def chain_hash(prev_line: str, tag: str, turn_sha: str, transcript_sha: str) -> str:
    return sha256_bytes((prev_line + tag + turn_sha + transcript_sha).encode())


def chain_lines(ws: Path):
    p = ws / CHAIN_NAME
    return p.read_text().splitlines() if p.is_file() else []


def chain_add(ws: Path, tag: str, turn_sha: str) -> str:
    lines = chain_lines(ws)
    transcript_sha = sha256_file(ws / "transcript.md")
    head = chain_hash(lines[-1] if lines else "", tag, turn_sha, transcript_sha)
    with (ws / CHAIN_NAME).open("a") as f:
        f.write(f"{head} {tag} {turn_sha} {transcript_sha}\n")
    return head


def chain_issues(ws: Path, data: bytes, entries):
    """Recompute the upstream line-linked format; never trust paths from chain tags."""
    issues = []
    lines = chain_lines(ws)
    if not lines:
        return ["CHAIN.SHA256 missing or empty"], None
    prev = ""
    head = None
    turns = []
    transcript_shas = []
    for n, line in enumerate(lines, 1):
        m = re.fullmatch(r"([0-9a-f]{64}) (r\d+-s\d+|close) ([0-9a-f]{64}) ([0-9a-f]{64})", line)
        if not m:
            issues.append(f"CHAIN.SHA256 line {n}: malformed")
            break
        h, tag, tsha, trsha = m.groups()
        if chain_hash(prev, tag, tsha, trsha) != h:
            issues.append(f"CHAIN.SHA256 line {n}: hash does not recompute")
        if tag == "close":
            closing = data.rstrip(b"\n").rsplit(b"\n", 1)[-1]
            if n != len(lines) or not re.fullmatch(
                rb"## Closed \xe2\x80\x94 (?:saturation|cap|refuter-handoff), round -?\d+", closing
            ) or sha256_bytes(closing) != tsha:
                issues.append(f"CHAIN.SHA256 line {n}: closing record mismatch")
            if marker_path(ws).exists():
                issues.append("closed chain still has an active marker")
        else:
            turns.append((tag, tsha))
            tf = ws / "turns" / f"{tag}.md"
            if not tf.is_file() or sha256_file(tf) != tsha:
                issues.append(f"CHAIN.SHA256 line {n}: turn {tag} sha mismatch or file missing")
        transcript_shas.append(trsha)
        prev, head = line, h
    expected_turns = [(f"r{e['round']}-s{e['seat']}", e["hash"]) for e in entries]
    if turns != expected_turns or len(set(tag for tag, _ in turns)) != len(turns):
        issues.append("CHAIN.SHA256 turn order/count/hash != transcript entries")
    if transcript_shas and transcript_shas[-1] != sha256_bytes(data):
        issues.append("CHAIN.SHA256 last transcript sha != transcript.md sha")
    checksum = transcript_sha_file(ws)
    recorded = [line.split()[0] for line in checksum.read_text().splitlines() if line.strip()] if checksum.is_file() else []
    if recorded != transcript_shas:
        issues.append("CHAIN.SHA256 transcript hashes != TRANSCRIPT.SHA256 history")
    return issues, head


def append_transcript_sha(ws: Path, note: str):
    transcript = ws / "transcript.md"
    sha = sha256_file(transcript)
    with transcript_sha_file(ws).open("a") as f:
        f.write(f"{sha}  transcript.md  {note}\n")


# ---------- open ----------

def cmd_open(argv):
    if len(argv) != 1:
        die(2, "usage: tribunal-scribe open <ws>")
    ws = Path(argv[0]).resolve()

    leftovers = []
    if (ws / "turns").exists():
        leftovers.append("turns/")
    if list(ws.glob("seat-*.md")):
        leftovers.append("seat-*.md")
    if (ws / "transcript.md").exists():
        leftovers.append("transcript.md")
    for extra in (CHAIN_NAME, "TRANSCRIPT.SHA256"):
        if (ws / extra).exists():
            leftovers.append(extra)
    if leftovers:
        die(1, f"prior-run leftovers in {ws}: {', '.join(leftovers)} — move them to "
                f"{ws}/prior-run-<ts>/ or pick a fresh workspace")

    ws.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["git", "-C", str(ws), "rev-parse", "HEAD"],
                        capture_output=True, text=True)
    if r.returncode != 0:
        die(1, f"git rev-parse HEAD failed in {ws}: {r.stderr.strip()}")
    head = r.stdout.strip()
    opened = datetime.now(timezone.utc).isoformat()

    marker_path(ws).write_text(f"head={head}\nopened={opened}\n")
    (ws / "turns").mkdir(parents=True, exist_ok=True)
    print(f"opened {ws} at head={head}")


# ---------- append ----------

def _heading_for_round(round_: int) -> bytes:
    if round_ == 0:
        return "## Round 0 — opening statements".encode()
    return f"## Round {round_}".encode()


def _longest_backtick_run(data: bytes) -> int:
    longest = 0
    run = 0
    for b in data:
        if b == 0x60:  # '`'
            run += 1
            longest = max(longest, run)
        else:
            run = 0
    return longest


def _fenced_line_indices(lines):
    """Indices (into `lines`, a bytes-per-line split of transcript.md) that fall inside a
    scribe-written fenced turn payload -- the fence-open line, its content, and the fence-close
    line, inclusive. A judge's payload can legitimately contain a line that reads exactly
    `## Round 2` or `### Seat 9 (fake) sha256:...` (that's the whole point of storing turns
    byte-for-byte); heading/seat-header detection must never mistake that payload content for
    real transcript structure. Mirrors the fence-open/skip-to-close walk _parse_transcript uses
    to extract a turn's fenced_region, kept as its own pass so cmd_append's has_heading check
    (which never walks fenced_region content) can reuse it too."""
    fenced = set()
    i, n = 0, len(lines)
    while i < n:
        line = lines[i]
        if SEAT_RE.match(line):
            j = i + 1
            while j < n and lines[j] == b"":
                j += 1
            fm = FENCE_OPEN_RE.match(lines[j]) if j < n else None
            if fm:
                fence_len = len(fm.group(1))
                close_pat = b"`" * fence_len
                k = j
                while k < n and lines[k] != close_pat:
                    k += 1
                end = k if k < n else n - 1
                fenced.update(range(j, end + 1))
                i = end + 1
                continue
        i += 1
    return fenced


def _has_real_heading(data: bytes, heading: bytes) -> bool:
    """True iff `heading` appears as its own line OUTSIDE any fenced turn payload span (tribunal
    fix step 3 review: a payload whose content is literally `## Round 2` must never suppress the
    real Round 2 heading that gets written when that round's next turn actually arrives)."""
    lines = data.split(b"\n")
    fenced = _fenced_line_indices(lines)
    return any(line == heading for idx, line in enumerate(lines) if idx not in fenced)


def cmd_append(argv):
    if len(argv) != 5:
        die(2, "usage: tribunal-scribe append <ws> <round> <seat> <lens> <payload-file>")
    ws = Path(argv[0]).resolve()
    try:
        round_ = int(argv[1])
        seat = int(argv[2])
    except ValueError:
        die(2, "round and seat must be integers")
    lens = argv[3]
    if not LENS_RE.match(lens):
        die(2, f"invalid lens {lens!r}: must match {LENS_RE.pattern!r} "
                "(lowercase alphanumeric + hyphen, no path separators)")
    payload_file = Path(argv[4])

    marker = require_marker(ws)
    integrity_check(ws, marker["head"])

    if not payload_file.is_file():
        die(1, f"payload file not found: {payload_file}")
    payload = payload_file.read_bytes()

    turns_dir = ws / "turns"
    turns_dir.mkdir(parents=True, exist_ok=True)
    turn_path = turns_dir / f"r{round_}-s{seat}.md"
    if turn_path.exists():
        die(1, f"refuse to overwrite {turn_path}")
    turn_path.write_bytes(payload)

    if round_ == 0:
        seat_path = ws / f"seat-{seat}-{lens}.md"
        if seat_path.exists():
            die(1, f"refuse to overwrite {seat_path}")
        seat_path.write_bytes(payload)

    # ---- transcript.md ----
    transcript_path = ws / "transcript.md"
    existing = transcript_path.read_bytes() if transcript_path.exists() else b""

    heading = _heading_for_round(round_)
    has_heading = _has_real_heading(existing, heading)
    out = existing
    if not has_heading:
        if out and not out.endswith(b"\n\n"):
            out += b"\n" if out.endswith(b"\n") else b"\n\n"
        out += heading + b"\n\n"

    fence_len = max(3, _longest_backtick_run(payload) + 1)
    fence = b"`" * fence_len
    body = payload if payload.endswith(b"\n") else payload + b"\n"
    sha_full = sha256_bytes(payload)
    seat_header = f"### Seat {seat} ({lens}) sha256:{sha_full}".encode()

    out += seat_header + b"\n" + fence + b"turn\n" + body + fence + b"\n\n"
    transcript_path.write_bytes(out)

    append_transcript_sha(ws, f"after r{round_}-s{seat}")
    head = chain_add(ws, f"r{round_}-s{seat}", sha_full)
    print(f"appended round {round_} seat {seat} ({lens}) -> {turn_path}")
    print(f"chain-head {head}")


# ---------- close ----------

def cmd_close(argv):
    if len(argv) != 3:
        die(2, "usage: tribunal-scribe close <ws> <reason> <round>")
    ws = Path(argv[0]).resolve()
    reason = argv[1]
    try:
        round_ = int(argv[2])
    except ValueError:
        die(2, "round must be an integer")
    if reason not in REASONS:
        die(2, f"reason must be one of {sorted(REASONS)}, got {reason!r}")

    marker = require_marker(ws)
    integrity_check(ws, marker["head"])

    transcript_path = ws / "transcript.md"
    existing = transcript_path.read_bytes() if transcript_path.exists() else b""
    closing = f"## Closed — {reason}, round {round_}".encode()
    out = existing
    if out and not out.endswith(b"\n\n"):
        out += b"\n" if out.endswith(b"\n") else b"\n\n"
    out += closing + b"\n"
    transcript_path.write_bytes(out)

    append_transcript_sha(ws, "after close")
    head = chain_add(ws, "close", sha256_bytes(closing))
    marker_path(ws).unlink(missing_ok=True)
    print(f"closed {ws}: {reason}, round {round_}")
    print(f"chain-head {head}")
    print(f"close-head: {head}")


# ---------- verify ----------

def _parse_transcript(data: bytes):
    """-> list of {round, seat, lens, hash, fenced_region} in file order. fenced_region is the
    exact bytes the scribe wrote between the fences (see module docstring's trailing-newline
    note) — always ends with exactly one \\n."""
    lines = data.split(b"\n")
    # Defense in depth on top of the fence-aware i-jumping below (which already never revisits
    # fenced content directly): explicitly refuse to treat a payload's own `## Round N` /
    # `### Seat n (...)` -shaped line as real structure, should that jumping logic ever change.
    fenced = _fenced_line_indices(lines)
    entries = []
    current_round = None
    i, n = 0, len(lines)
    while i < n:
        line = lines[i]
        m = ROUND_RE.match(line) if i not in fenced else None
        if m:
            current_round = int(m.group(1))
            i += 1
            continue
        m2 = SEAT_RE.match(line) if i not in fenced else None
        if m2:
            seat = int(m2.group(1))
            lens = m2.group(2).decode("utf-8", "replace")
            h = m2.group(3).decode()
            i += 1
            while i < n and lines[i] == b"":
                i += 1
            fm = FENCE_OPEN_RE.match(lines[i]) if i < n else None
            if not fm:
                continue  # malformed block — not a scribe-written turn, skip
            fence_len = len(fm.group(1))
            i += 1
            content_start = i
            close_pat = b"`" * fence_len
            while i < n and lines[i] != close_pat:
                i += 1
            content_lines = lines[content_start:i]
            fenced_region = b"\n".join(content_lines) + b"\n"
            entries.append({"round": current_round, "seat": seat, "lens": lens,
                             "hash": h, "fenced_region": fenced_region})
            i += 1
            continue
        i += 1
    return entries


def cmd_verify(argv):
    expect_head = None
    if "--expect-head" in argv:
        i = argv.index("--expect-head")
        if i + 1 >= len(argv) or not re.fullmatch(r"[0-9a-f]{64}", argv[i + 1]):
            die(2, "--expect-head needs a 64-hex sha256 value")
        expect_head = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    if len(argv) != 1:
        die(2, "usage: tribunal-scribe verify <ws> [--expect-head <sha>]")
    ws = Path(argv[0]).resolve()
    issues = []

    if not ws.is_dir():
        die(3, f"workspace is not a directory: {ws}")
    turns_dir = ws / "turns"
    if not turns_dir.is_dir():
        issues.append("turns/ missing or not a directory")

    transcript_path = ws / "transcript.md"
    transcript_data = transcript_path.read_bytes() if transcript_path.is_file() else b""
    checksum_path = transcript_sha_file(ws)
    pristine_open = (
        marker_path(ws).is_file() and turns_dir.is_dir()
        and not any(turns_dir.iterdir()) and not list(ws.glob("seat-*.md"))
        and not transcript_path.exists() and not checksum_path.exists()
        and not (ws / CHAIN_NAME).exists()
    )
    if not pristine_open:
        if not transcript_path.is_file() or not transcript_data:
            issues.append("transcript.md missing, empty or not a file")
        if not checksum_path.is_file():
            issues.append("TRANSCRIPT.SHA256 missing or not a file")
    entries = _parse_transcript(transcript_data)
    if not pristine_open and not entries and not re.fullmatch(
        rb"## Closed \xe2\x80\x94 (?:saturation|cap|refuter-handoff), round -?\d+\n",
        transcript_data,
    ):
        issues.append("transcript.md has no turn evidence or closing record")

    # 1. every turns/ file sha vs the sha in its transcript heading
    by_key = {}
    for e in entries:
        by_key[(e["round"], e["seat"])] = e
    turn_files = sorted(turns_dir.glob("r*-s*.md")) if turns_dir.is_dir() else []
    seen_keys = set()
    turn_re = re.compile(r'^r(\d+)-s(\d+)\.md$')
    for tf in turn_files:
        m = turn_re.match(tf.name)
        if not m:
            continue
        key = (int(m.group(1)), int(m.group(2)))
        seen_keys.add(key)
        e = by_key.get(key)
        if e is None:
            issues.append(f"turns/{tf.name}: no matching transcript heading")
            continue
        actual = sha256_file(tf)
        if actual != e["hash"]:
            issues.append(f"turns/{tf.name}: sha256 {actual} != transcript heading sha {e['hash']}")
    for key, e in by_key.items():
        if key not in seen_keys:
            issues.append(f"transcript round {e['round']} seat {e['seat']}: no turns/r{key[0]}-s{key[1]}.md on disk")

    # 2. transcript sha vs TRANSCRIPT.SHA256 last line
    recorded = last_recorded_sha(ws) if checksum_path.is_file() else None
    if not pristine_open:
        actual_transcript_sha = sha256_bytes(transcript_data) if transcript_path.is_file() else None
        if recorded is None:
            issues.append("TRANSCRIPT.SHA256 missing or empty while transcript.md exists")
        elif actual_transcript_sha != recorded:
            issues.append(f"transcript.md sha {actual_transcript_sha} != TRANSCRIPT.SHA256 last line {recorded}")

    # 3. each fenced payload byte-equals its turns/ file (up to the one controlled trailing
    # newline noted in the module docstring)
    for e in entries:
        key = (e["round"], e["seat"])
        if key not in seen_keys:
            continue  # already reported above
        tf = turns_dir / f"r{key[0]}-s{key[1]}.md"
        turn_bytes = tf.read_bytes()
        ok = e["fenced_region"] == turn_bytes or e["fenced_region"] == turn_bytes + b"\n"
        if not ok:
            issues.append(f"transcript round {key[0]} seat {key[1]}: fenced payload != turns/{tf.name}")

    head = None
    if not pristine_open:
        chain_errors, head = chain_issues(ws, transcript_data, entries)
        issues.extend(chain_errors)
    marker = read_marker(ws)
    if marker is not None and not re.fullmatch(r"[0-9a-f]{40}", marker.get("head", "")):
        issues.append("marker head is not a 40-hex commit sha")
    for sf in sorted(ws.glob("seat-*.md")):
        m = re.fullmatch(r"seat-(\d+)-.+\.md", sf.name)
        tf = turns_dir / f"r0-s{m.group(1)}.md" if m else None
        if tf is None or not tf.is_file() or sf.read_bytes() != tf.read_bytes():
            issues.append(f"{sf.name}: missing or different r0 turn")
    for key, e in by_key.items():
        if key[0] == 0 and not (ws / f"seat-{key[1]}-{e['lens']}.md").is_file():
            issues.append(f"round 0 seat {key[1]}: seat file missing")
    if expect_head is not None and expect_head != head:
        issues.append(f"chain head {head} != --expect-head {expect_head}")
    if head:
        print(f"chain-head {head}")
    if issues:
        print(f"{PROG} verify: {len(issues)} issue(s) in {ws}")
        for i in issues:
            print(f"  - {i}")
        sys.exit(3)
    scope = "caller-supplied head matched" if expect_head is not None else "local consistency only; no external anchor supplied"
    print(f"{PROG} verify: clean ({ws}); {scope}")


def main():
    argv = sys.argv[1:]
    if not argv:
        die(2, "usage: tribunal-scribe <open|append|close|verify> ...")
    cmd, rest = argv[0], argv[1:]
    if cmd == "open":
        cmd_open(rest)
    elif cmd == "append":
        cmd_append(rest)
    elif cmd == "close":
        cmd_close(rest)
    elif cmd == "verify":
        try:
            cmd_verify(rest)
        except (OSError, UnicodeDecodeError) as e:
            die(3, f"unreadable record: {e}")
    else:
        die(2, f"unknown subcommand: {cmd}")


if __name__ == "__main__":
    main()
