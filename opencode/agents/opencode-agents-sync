#!/usr/bin/env python3
"""Generate an OpenCode `agent` block from the collection's role files (stdlib only).

Reads agents/<name>.md and agents/<name>/<name>.md (frontmatter: name, description, tools),
and prints JSON of the form {"agent": {<name>: {...}}} to merge into opencode.json.

  opencode-agents-sync [--agents-dir DIR] [--model PROVIDER/MODEL] [--out FILE]
  opencode-agents-sync --check FILE        exit 1 if FILE differs from a fresh generation

The model is a placeholder (default provider/model-name): replace it with a model you have
configured. Nothing here selects accounts, quotas or providers. The declared `tools` list
is turned into switch-offs only: each of these OpenCode tool ids that the role does not name is emitted
as false (read, edit, bash, grep, glob, webfetch; Edit and Write both map to `edit`, which is off only when
neither is named). Named tools get no entry, so they stay under the user's own permission settings. Names
that have no OpenCode counterpart are ignored. The generator never writes anywhere but --out.
"""
import argparse
import json
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
TOOLSET = {  # Claude-style tool name -> OpenCode tool id
    "Read": "read", "Write": "edit", "Edit": "edit", "Bash": "bash",
    "Grep": "grep", "Glob": "glob", "WebFetch": "webfetch",
}
ALL_IDS = sorted(set(TOOLSET.values()))


def parse(path):
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n") or "\n---\n" not in text[4:]:
        raise SystemExit(f"{path}: missing or unterminated frontmatter")
    header, body = text[4:].split("\n---\n", 1)
    meta = {}
    for line in header.splitlines():
        m = re.fullmatch(r"([a-z][a-z-]*): (.*)", line)
        if not m:
            raise SystemExit(f"{path}: unsupported frontmatter line: {line!r}")
        meta[m.group(1)] = m.group(2).strip().strip("\"'")
    for key in ("name", "description"):
        if not meta.get(key):
            raise SystemExit(f"{path}: frontmatter lacks {key}")
    return meta, body.strip("\n") + "\n"


def role_files(agents_dir):
    found = {}
    for p in sorted(agents_dir.glob("*.md")):
        found[p.stem] = p
    for p in sorted(agents_dir.glob("*/*.md")):
        if p.stem == p.parent.name:
            found[p.stem] = p
    return found


def build(agents_dir, model):
    agents = {}
    for name, path in sorted(role_files(agents_dir).items()):
        meta, body = parse(path)
        if meta["name"] != name:
            raise SystemExit(f"{path}: frontmatter name {meta['name']!r} != file name {name!r}")
        entry = {"description": meta["description"], "mode": "subagent", "model": model, "prompt": body}
        if "tools" in meta:
            named = {TOOLSET[t.strip()] for t in meta["tools"].split(",") if t.strip() in TOOLSET}
            off = {i: False for i in ALL_IDS if i not in named}
            if off:
                entry["tools"] = off
        agents[name] = entry
    if not agents:
        raise SystemExit(f"no role files under {agents_dir}")
    return {"agent": agents}


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--agents-dir", default=str(HERE.parent.parent / "agents"))
    ap.add_argument("--model", default="provider/model-name")
    ap.add_argument("--out")
    ap.add_argument("--check")
    a = ap.parse_args()
    text = json.dumps(build(Path(a.agents_dir), a.model), indent=2, ensure_ascii=False) + "\n"
    if a.check:
        if Path(a.check).read_text(encoding="utf-8") != text:
            print(f"differs from a fresh generation: {a.check}", file=sys.stderr)
            return 1
        print(f"ok: {a.check} matches")
        return 0
    if a.out:
        Path(a.out).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
