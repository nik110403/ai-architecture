#!/usr/bin/env python3
# AI_ARCH_FAKE_HARNESS: a test double for the claude harness. It never reaches a model and never opens a socket.
# It reads scenario.json next to itself, keyed by the item id the runner puts in the prompt ("Item: <id>").
import json, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
if "--version" in sys.argv[1:]:
    print("fake-claude 0.0.0")
    sys.exit(0)
prompt = sys.stdin.read()
item = (re.search(r"^Item: (\S+)", prompt, re.M) or [None, "?"])[1]
attempt = (re.search(r"^Attempt: (\d+)", prompt, re.M) or [None, "1"])[1]
try:
    scenario = json.load(open(os.path.join(HERE, "scenario.json")))
except OSError:
    scenario = {}
cfg = dict(scenario.get("*", {}))
cfg.update(scenario.get(item, {}))
cfg.update(cfg.get("attempts", {}).get(attempt, {}))
os.makedirs(os.path.join(HERE, "pids"), exist_ok=True)
with open(os.path.join(HERE, "dispatch.log"), "a") as log:
    log.write(f"{item} {attempt} {os.getpid()}\n")
with open(os.path.join(HERE, "pids", f"{item}.{attempt}"), "w") as fh:
    fh.write(f"{os.getpid()} {os.getpgid(0)}\n")
if cfg.get("spawn_child"):
    child = subprocess.Popen(["sleep", "300"])
    with open(os.path.join(HERE, "pids", f"{item}.{attempt}.child"), "w") as fh:
        fh.write(f"{child.pid}\n")
gate = cfg.get("hold")
if gate:
    open(gate + ".started", "w").close()
    end = time.time() + 120
    while not os.path.exists(gate) and time.time() < end:
        time.sleep(0.05)
for write in cfg.get("writes", []):
    path = write["path"]
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as fh:
        fh.write(write.get("content", "ok\n"))
for edit in cfg.get("edits", []):
    text = open(edit["path"]).read()
    open(edit["path"], "w").write(text.replace(edit["find"], edit["replace"]))
if (cfg.get("writes") or cfg.get("edits")) and not cfg.get("no_commit"):
    git = ["git", "-c", "core.hooksPath=/dev/null", "-c", "user.name=fake", "-c", "user.email=fake@example.invalid", "-c", "commit.gpgsign=false"]
    subprocess.run(git + ["add", "-A"], check=True)
    subprocess.run(git + ["commit", "-q", "-m", f"fake: {item} attempt {attempt}"], check=True)
result = {"type": "result", "subtype": "success", "is_error": False, "permission_denials": [], "result": "done"}
usage = cfg.get("usage", {"input": 100, "output": 50, "cache_read": 0, "cache_write": 0})
if usage is not None:
    result["usage"] = {"input_tokens": usage["input"], "output_tokens": usage["output"],
                       "cache_read_input_tokens": usage["cache_read"], "cache_creation_input_tokens": usage["cache_write"]}
    result["total_cost_usd"] = cfg.get("cost", 0.01)
print(json.dumps(result))
sys.exit(cfg.get("exit", 0))
