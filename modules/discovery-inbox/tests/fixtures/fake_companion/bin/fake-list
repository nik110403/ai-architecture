#!/usr/bin/env python3
"""fake-list [status]"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fake_lib as L

wanted = sys.argv[1] if len(sys.argv) > 1 else None
for _path, meta, _body in L.all_repos():
    if wanted and meta.get("status") != wanted:
        continue
    print(f"{meta.get('status', ''):<10} {meta.get('priority', ''):<6} {meta.get('category', ''):<14} {meta.get('repo', ''):<40} ")
